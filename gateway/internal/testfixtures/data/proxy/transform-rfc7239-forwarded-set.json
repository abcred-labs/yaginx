        "X-Fixture": "",
        "X-Fixture-Forward-Proxy": "",
        "X-Forwarded-For": "",
        "X-Forwarded-Host": "",
        "X-Forwarded-Prefix": "",
        "X-Forwarded-Proto": ""
      },
      "host": "127.0.0.1:20180",
      "method": "GET",
      "path": "/forwarded"
    }
  },
  "upstream": {
