{
  "configVersion": 1,
  "database": {
    "dsn": "REPLACE_WITH_APPROVED_RUNTIME_DSN",
    "maxConnections": 8,
    "minConnections": 1
  },
  "proxy": {
    "activityTimeout": "5m",
    "responseHeaderTimeout": "30s",
    "maxConcurrentRequests": 256,
    "maxRequestHeaderBytes": 65536,
    "maxRequestBodyBytes": 0,
    "maxIdleConnections": 128,
    "maxIdleConnectionsPerHost": 16
  },
  "trafficAggregation": {
    "maxQueueBytes": 8388608,
    "batchSize": 500,
    "enableUAParsing": false,
    "uaCacheSize": 2000
  },
  "requestHistory": {
    "enabled": true,
    "recordMode": "ErrorsOnly",
    "successSamplingRate": 0,
    "bodyCaptureMaxBytes": 8192,
    "maxHeaderBytes": 8192,
    "maxQueueBytes": 16777216,
    "batchSize": 250,
    "maxFlushRetryCount": 1,
    "retentionHours": 48
  },
  "ports": {
    "bindAddress": "0.0.0.0",
    "http": 8080,
    "proxyHttp": 9080,
    "https": 8443,
    "proxyHttps": 9443,
    "management": 9090
  },
  "management": {
    "allowedCIDRs": ["198.51.100.0/24", "127.0.0.0/8", "::1/128"]
  },
  "listeners": {
    "http3": {
      "enabled": false
    },
    "proxyProtocol": {
      "trustedCIDRs": ["127.0.0.1/32"],
      "requiredOnProxyListeners": true
    }
  },
  "observability": {},
  "acme": {
    "email": "operator@example.com",
    "directoryURL": "https://acme-v02.api.letsencrypt.org/directory",
    "renewBefore": "168h",
    "keyValueEndpointURL": ""
  },
  "upgrade": {
    "enabled": false
  }
}
