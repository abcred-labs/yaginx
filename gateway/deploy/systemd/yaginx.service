[Unit]
Description=Yaginx Go Gateway
After=network-online.target
Wants=network-online.target
Conflicts=yaginx-core.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/yaginx serve --config /etc/yaginx/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
TimeoutStopSec=330
Environment="GOMEMLIMIT=700MiB"
Environment="GOGC=75"
MemoryHigh=768M
MemoryMax=1G
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/yaginx /var/lib/yaginx /var/log/yaginx
UMask=0077
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
