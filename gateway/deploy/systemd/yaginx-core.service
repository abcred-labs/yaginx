[Unit]
Description=Yaginx Core Rescue Gateway
After=network-online.target
Wants=network-online.target
Conflicts=yaginx.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/yaginx-core --snapshot /var/lib/yaginx/core/runtime.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
LimitNOFILE=1048576
