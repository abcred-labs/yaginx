{
  "version": 1,
  "matrixLine": 68,
  "name": "child-rule-unsafe-upstream-tls",
  "source": "dotnet",
  "listener": {
    "port": 18080,
    "transport": "tcp"
  },
  "config": {
    "defaultHost": "proxy-child-transport-fixture.example.invalid",
    "proxyRules": [
      {
        "pathPattern": "unsafe-tls",
        "isEnabled": true,
        "destination": "https://127.0.0.1:20182",
        "allowInvalidTlsCertificate": true
      }
    ]
  },
  "client": {
    "method": "GET",
    "host": "proxy-child-transport-fixture.example.invalid",
    "path": "/unsafe-tls/child",
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "Date": "${NOW}",
      "Vary": "Accept-Encoding"
    },
    "body": {
      "headers": {
        "X-Fixture": "",
        "X-Fixture-Forward-Proxy": "",
        "X-Forwarded-For": "127.0.0.1",
        "X-Forwarded-Host": "proxy-child-transport-fixture.example.invalid",
        "X-Forwarded-Prefix": "",
        "X-Forwarded-Proto": "http"
      },
      "host": "127.0.0.1:20182",
      "method": "GET",
      "path": "/unsafe-tls/child"
    }
  },
  "upstream": {
    "attempted": true,
    "method": "GET",
    "host": "127.0.0.1:20182",
    "path": "/unsafe-tls/child",
    "status": 200,
    "headers": {
      "X-Fixture": "",
      "X-Fixture-Forward-Proxy": "",
      "X-Forwarded-For": "127.0.0.1",
      "X-Forwarded-Host": "proxy-child-transport-fixture.example.invalid",
      "X-Forwarded-Prefix": "",
      "X-Forwarded-Proto": "http"
    }
  },
  "history": {
    "status": 200,
    "statusSource": "Upstream",
    "errorCategory": ""
  }
}
