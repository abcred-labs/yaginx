    "host": "proxy-transform-response-trailer-fixture.example.invalid",
    "path": "/trailers",
    "status": 200,
    "headers": {
      "Content-Type": "application/json",
      "Date": "${NOW}",
      "Vary": "Accept-Encoding"
    },
    "trailers": {
      "X-Fixture-Trailer": ""
    },
    "body": {
      "headers": {
        "Forwarded": "",
        "X-Fixture": "",
        "X-Fixture-Forward-Proxy": "",
        "X-Forwarded-For": "127.0.0.1",
        "X-Forwarded-Host": "proxy-transform-response-trailer-fixture.example.invalid",
        "X-Forwarded-Prefix": "",
        "X-Forwarded-Proto": "http"
      },
      "host": "127.0.0.1:20180",
      "method": "GET",
      "path": "/trailers"
    }
  },
  "upstream": {
    "attempted": true,
    "method": "GET",
    "host": "127.0.0.1:20180",
    "path": "/trailers",
    "status": 200,
    "headers": {
      "Forwarded": "",
      "X-Fixture": "",
      "X-Fixture-Forward-Proxy": "",
      "X-Forwarded-For": "127.0.0.1",
      "X-Forwarded-Host": "proxy-transform-response-trailer-fixture.example.invalid",
      "X-Forwarded-Prefix": "",
      "X-Forwarded-Proto": "http"
    }
  },
  "history": {
    "status": 200,
    "statusSource": "Upstream",
    "errorCategory": ""
  }
}
