{
  "version": 1,
  "matrixLine": 93,
  "name": "transform-response-trailer-set",
  "source": "dotnet",
  "listener": {
    "port": 18080,
    "transport": "tcp"
  },
  "config": {
    "defaultHost": "proxy-transform-response-trailer-fixture.example.invalid",
    "proxyTransforms": {
      "ResponseTrailer": "X-Fixture-Added",
      "Set": "transformed",
      "When": "Always"
    }
  },
  "client": {
