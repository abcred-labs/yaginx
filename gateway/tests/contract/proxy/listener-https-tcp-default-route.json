{
  "version": 1,
  "matrixLine": 11,
  "name": "listener-https-tcp-default-route",
  "source": "dotnet",
  "listener": {
    "port": 18443,
    "transport": "tcp"
  },
  "config": {
    "defaultHost": "proxy-fixture.example.invalid",
    "defaultDestination": "http://127.0.0.1:20180"
  },
  "client": {
    "method": "GET",
    "host": "proxy-fixture.example.invalid",
    "path": "/tls-fixture",
    "status": 200,
    "headers": {
      "Alt-Svc": "h3=\":18443\"; ma=86400",
      "Content-Type": "application/json",
      "Date": "${NOW}",
      "Vary": "Accept-Encoding"
    },
    "body": {
      "headers": {
        "X-Fixture": "",
        "X-Fixture-Forward-Proxy": "",
        "X-Forwarded-For": "127.0.0.1",
        "X-Forwarded-Host": "proxy-fixture.example.invalid",
        "X-Forwarded-Prefix": "",
        "X-Forwarded-Proto": "https"
      },
      "host": "127.0.0.1:20180",
      "method": "GET",
      "path": "/tls-fixture"
    }
  },
  "upstream": {
    "attempted": true,
    "method": "GET",
    "host": "127.0.0.1:20180",
    "path": "/tls-fixture",
    "status": 200,
    "headers": {
      "X-Fixture": "",
      "X-Fixture-Forward-Proxy": "",
      "X-Forwarded-For": "127.0.0.1",
      "X-Forwarded-Host": "proxy-fixture.example.invalid",
      "X-Forwarded-Prefix": "",
      "X-Forwarded-Proto": "https"
    }
  },
  "history": {
    "status": 200,
    "statusSource": "Upstream",
    "errorCategory": ""
  }
}
