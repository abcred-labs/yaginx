{
  "version": 1,
  "matrixLine": 144,
  "name": "streaming-websocket-upgrade-subprotocol-and-frame",
  "source": "dotnet",
  "listener": {
    "port": 18080,
    "transport": "tcp"
  },
  "config": {
    "defaultHost": "proxy-stream-websocket-fixture.example.invalid",
    "upstreamMode": "websocket",
    "subprotocol": "fixture-protocol",
    "frame": "fixture-websocket"
  },
  "client": {
    "method": "GET",
    "host": "proxy-stream-websocket-fixture.example.invalid",
    "path": "/websocket",
    "status": 101,
    "headers": {
      "Connection": "Upgrade",
      "Date": "${NOW}",
      "Sec-Websocket-Accept": "/UdzP01uSiSaJ7oHb1F8N7uUSCg=",
      "Sec-Websocket-Protocol": "fixture-protocol",
      "Upgrade": "websocket"
    },
    "body": {
      "received": "fixture-websocket",
      "sent": "fixture-websocket",
      "subprotocol": "fixture-protocol"
    }
  },
  "upstream": {
    "attempted": true,
    "method": "GET",
    "host": "127.0.0.1:20180",
    "path": "/websocket",
    "status": 101
  },
  "history": {
    "status": 101,
    "statusSource": "Upstream",
    "errorCategory": ""
  }
}
