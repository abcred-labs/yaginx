{
  "version": 1,
  "operationId": "accountRefreshToken",
  "scenario": "success",
  "approvalId": "v2-api-account-refresh-token-cookie-success",
  "request": {
    "method": "GET",
    "path": "/api/account/refresh_token",
    "headers": {
      "Cookie": "${REDACTED_REFRESH_COOKIE}"
    }
  },
  "response": {
