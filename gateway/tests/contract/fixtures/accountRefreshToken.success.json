      "data": {
        "expiresIn": 600,
        "name": "${REDACTED_EMAIL}",
        "token": "${REDACTED_TOKEN}",
        "userId": "${REDACTED_EMAIL}"
      },
      "errMsg": null,
      "msg": null,
      "tid": "${TID}"
    }
  },
  "source": "approved-test-adapter"
}
