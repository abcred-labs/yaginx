{
  "version": 1,
  "operationId": "passwordRecoveryStart",
  "scenario": "success",
  "request": {
    "method": "POST",
    "path": "/api/account/password_recovery/start",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "accountEmail": "${REDACTED_ACCOUNTEMAIL}"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Act-Trace-Id": "${RANDOM_ID}",
      "Content-Type": "application/json",
      "Date": "${NOW}",
      "Duration": "${RUNTIME_METADATA}",
      "Handler-Node": "${RUNTIME_METADATA}",
      "Vary": "Accept-Encoding"
    },
    "body": {
      "code": 200,
      "data": {
        "maskedEmail": "${REDACTED_MASKEDEMAIL}",
        "recoveryId": "${REDACTED_RECOVERYID}"
      },
      "errMsg": null,
      "msg": null,
      "tid": "${TID}"
    }
  },
  "source": "dotnet"
}
