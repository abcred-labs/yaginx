{
  "version": 1,
  "operationId": "accountRegister",
  "scenario": "success",
  "request": {
    "method": "POST",
    "path": "/api/account/register",
    "headers": {
      "Authorization": "${REDACTED_AUTHORIZATION}",
      "Content-Type": "application/json"
    },
    "body": {
      "email": "${REDACTED_EMAIL}",
      "password": "${REDACTED_PASSWORD}"
    }
  },
  "response": {
    "status": 200,
    "headers": {
      "Act-Trace-Id": "${RANDOM_ID}",
      "Content-Type": "application/json",
      "Date": "${NOW}",
      "Duration": "${RUNTIME_METADATA}",
      "Handler-Node": "${RUNTIME_METADATA}",
      "Vary": "Accept-Encoding"
    },
    "body": {
      "code": 200,
      "data": {},
      "errMsg": null,
      "msg": null,
      "tid": "${TID}"
    }
  },
  "source": "dotnet"
}
