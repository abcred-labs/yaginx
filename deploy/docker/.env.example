# Required. Use letters and digits only (it is embedded in the database DSN).
POSTGRES_PASSWORD=

# Image tag: a release such as 0.2.0 (recommended) or latest.
YAGINX_VERSION=0.2.0

# Host ports.
YAGINX_HTTP_PORT=80
YAGINX_HTTPS_PORT=443
YAGINX_MANAGEMENT_PORT=9090
# Set to 0.0.0.0 only if the management port is protected by a firewall.
YAGINX_MANAGEMENT_BIND=127.0.0.1

# Optional: pull from a registry mirror, e.g. ghcr.abc.red/abcred-labs/yaginx
# YAGINX_IMAGE=ghcr.io/abcred-labs/yaginx
# Optional: PostgreSQL image (15 or newer), e.g. from a mirror.
# POSTGRES_IMAGE=postgres:18
