{
  "name": "yaginx.adminui",
  "private": false,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "restore": "pnpm install",
    "api:generate": "openapi-typescript ../planning/go-rewrite/contracts/management-api.openapi.yaml -o src/api/generated/management.ts",
    "api:check": "pnpm api:generate && git diff --exit-code -- src/api/generated/management.ts",
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:e2e": "pnpm run build && playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@modra/react": "0.0.162",
    "@modra/tailwind-preset": "0.0.162",
    "@modra/tokens": "0.0.162",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-table": "8.21.3",
    "brotli-wasm": "^3.0.1",
    "date-fns": "4.4.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.2",
    "fflate": "^0.8.3",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-day-picker": "10.0.1",
    "react-dom": "18.3.1",
    "react-error-boundary": "4.0.11",
    "react-hook-form": "7.84.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.5",
    "@types/qs": "^6.9.7",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "dayjs": "^1.11.23",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "moment": "^2.31.0",
    "openapi-typescript": "7.13.0",
    "qs": "^6.11.0",
    "terser": "^5.15.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^5.0.4",
    "zustand": "^5.0.15"
  },
  "main": "index.js",
  "license": "GPL-3.0-only",
  "pnpm": {
    "overrides": {
      "path-to-regexp": "8.4.0",
      "@babel/runtime": "7.26.10"
    }
  }
}
